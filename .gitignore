# Rust / Cargo
/target/

# Plugin build artifacts
/plugins/*.so
/plugins/*.dylib
/plugins/*.dll

# Runtime data
# /data/ 整目录不入库：队列/持久化文件由运行中的网关实例持续追加
# （曾因只忽略 /data/*.db 等顶层模式，导致 *.queue 子目录被误提交并反复膨胀）
/data/
/data/*.db
/data/*.db.bak
/data/*.json
/data/*.dat

# Logs
*.log
logs/

# OS
.DS_Store
Thumbs.db

# Superpowers brainstorming artifacts
.superpowers/

# Claude Code
.claude/

# IDE
.idea/
*.swp
*.swo
*~

# WorkBuddy 本地工作数据（AI 会话记忆等，不入库）
.workbuddy/

# Local env
.env
.env.*
!.env.example

# 密钥 / 授权签名私钥禁止入库（泄露后可签发任意 license）
scripts/*.pem
*.key
*.pkey

# 已签发的授权文件（每台机器不同，不应入库）
config/license.dat

# 初始管理员随机口令（首次登录后应删除）
/data/.admin_initial_password
**/.admin_initial_password

# 发布制品
dist/

# ZCode workspace metadata (machine-owned)
.zcode/

# Windows 保留设备名误产生的文件（重定向 > nul 在 POSIX shell 会生成字面文件）
nul
